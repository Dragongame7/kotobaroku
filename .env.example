PORT=3210
ASR_URL=http://127.0.0.1:8081
# OLLAMA_HOST is respected automatically. Override only when necessary.
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
# Settings saved in the UI take precedence. These initialize an unsaved connection.
# Set all three together to use a vLLM OpenAI-compatible endpoint:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://YOUR_IP:8001/v1
# LLM_MODEL=YOUR_SERVED_MODEL
# LLM_API_KEY=optional-key
# LLM_PROVIDER=ollama also works with LLM_BASE_URL and LLM_MODEL.
# 全LLM共通。TRANSLATION_MODEL / BOUNDARY_MODEL は廃止されました。
# Optional: path to a separately installed executable or GGUF model.
# NEMO_SPEECH_BIN=C:\path\to\nemo-speech.exe
# ASR_MODEL=nemotron-3.5
# Optional: custom Whisper runtime / GGML model. Labels must match the model used.
# WHISPER_BIN=C:\path\to\whisper-cli.exe
# WHISPER_MODEL=C:\path\to\ggml-large-v3.bin
# WHISPER_MODEL_LABEL=Whisper large-v3 · FP16
# WHISPER_DEVICE=cpu
