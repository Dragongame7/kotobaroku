# Copy to spark.env (excluded from Git). Use real values before deployment.
GATEWAY_API_KEY=REPLACE_WITH_RANDOM_GATEWAY_KEY
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8001
GATEWAY_ASR_URL=http://127.0.0.1:8081
GATEWAY_LLM_URL=http://127.0.0.1:8000/v1
GATEWAY_LLM_API_KEY=REPLACE_WITH_DIFFERENT_INTERNAL_KEY
GATEWAY_DIARIZATION=true
# Pin a tested Arm64/Blackwell image by digest, and a model revision.
VLLM_IMAGE=REPLACE_WITH_TESTED_IMAGE_AT_SHA256_DIGEST
MODEL_ID=google/gemma-4-E4B
MODEL_REVISION=REPLACE_WITH_MODEL_COMMIT
NEMO_SPEECH_MODEL_DIR=/opt/kotoba/.runtime/models
